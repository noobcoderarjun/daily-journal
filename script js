const SUPABASE_URL = "https://jaeemptfieualsexiulq.supabase.co/rest/v1/";
const SUPABASE_KEY = "sb_publishable_pQt7nCyMtlro_Oi63fNkbw_3Zl7nzmx";

const supabaseClient = window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
);


// ============================================
// SETTINGS
// ============================================

const CORRECT_PIN = "1234";


// ============================================
// ELEMENTS
// ============================================

const lockScreen = document.getElementById("lockScreen");
const journalScreen = document.getElementById("journalScreen");

const unlockBtn = document.getElementById("unlockBtn");
const lockBtn = document.getElementById("lockBtn");

const pinInputs = document.querySelectorAll(".pin");
const pinError = document.getElementById("pinError");

const todayDate = document.getElementById("todayDate");
const journalText = document.getElementById("journalText");
const shareEntry = document.getElementById("shareEntry");
const saveBtn = document.getElementById("saveBtn");
const savedMessage = document.getElementById("savedMessage");

const moodButtons = document.querySelectorAll(".mood");


// ============================================
// STATE
// ============================================

let currentUser = null;
let selectedMood = "";
let authReady = false;


// ============================================
// DATE
// ============================================

function getToday() {

    const now = new Date();

    const year = now.getFullYear();

    const month = String(
        now.getMonth() + 1
    ).padStart(2, "0");

    const day = String(
        now.getDate()
    ).padStart(2, "0");

    return `${year}-${month}-${day}`;
}


function updateDate() {

    const today = new Date();

    todayDate.textContent =
        today.toLocaleDateString("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric"
        });
}

updateDate();


// ============================================
// SUPABASE ANONYMOUS AUTH
// ============================================

async function initializeAuth() {

    try {

        // Check for an existing session
        const {
            data: {
                session
            }
        } = await supabaseClient.auth.getSession();


        if (session) {

            currentUser = session.user;
            authReady = true;

            console.log(
                "Existing user:",
                currentUser.id
            );

            return true;
        }


        // Create anonymous account
        const {
            data,
            error
        } = await supabaseClient.auth.signInAnonymously();


        if (error) {

            console.error(
                "Anonymous auth error:",
                error
            );

            authReady = false;

            return false;
        }


        currentUser = data.user;
        authReady = true;

        console.log(
            "Anonymous user created:",
            currentUser.id
        );

        return true;


    } catch (error) {

        console.error(
            "Authentication error:",
            error
        );

        authReady = false;

        return false;
    }
}


// Start authentication immediately
initializeAuth();


// ============================================
// PIN INPUT
// ============================================

pinInputs.forEach((input, index) => {

    // Only allow numbers
    input.addEventListener("keydown", (event) => {

        // Allow backspace
        if (event.key === "Backspace") {

            if (input.value === "" && index > 0) {

                pinInputs[index - 1].focus();

            }

            return;
        }


        // Allow left/right navigation
        if (event.key === "ArrowLeft") {

            if (index > 0) {
                pinInputs[index - 1].focus();
            }

            return;
        }


        if (event.key === "ArrowRight") {

            if (index < pinInputs.length - 1) {
                pinInputs[index + 1].focus();
            }

            return;
        }


        // Enter
        if (event.key === "Enter") {

            unlockJournal();

            return;
        }


        // Reject anything that isn't a number
        if (!/^\d$/.test(event.key)) {

            event.preventDefault();

            return;
        }


        // If this box already has a number,
        // replace it and move forward
        if (input.value !== "") {

            event.preventDefault();

            input.value = event.key;

            if (index < pinInputs.length - 1) {

                pinInputs[index + 1].focus();

            } else {

                // Last number entered
                unlockJournal();

            }

        }

    });


    // Handle pasted numbers
    input.addEventListener("input", () => {

        const value =
            input.value.replace(/\D/g, "");

        input.value = value.slice(-1);


        if (
            input.value &&
            index < pinInputs.length - 1
        ) {

            pinInputs[index + 1].focus();

        }


        // Automatically unlock after 4 digits
        if (getEnteredPin().length === 4) {

            unlockJournal();

        }

    });

});


// ============================================
// GET PIN
// ============================================

function getEnteredPin() {

    let pin = "";

    pinInputs.forEach(input => {

        pin += input.value;

    });

    return pin;
}


// ============================================
// UNLOCK
// ============================================

async function unlockJournal() {

    const enteredPin = getEnteredPin();


    if (enteredPin.length !== 4) {

        pinError.textContent =
            "Enter all 4 numbers.";

        return;
    }


    if (enteredPin !== CORRECT_PIN) {

        pinError.textContent =
            "Incorrect PIN.";

        pinInputs.forEach(input => {

            input.value = "";

        });

        pinInputs[0].focus();

        return;
    }


    // Correct PIN
    pinError.textContent =
        "Unlocking...";


    // Make sure Supabase authentication is ready
    if (!authReady || !currentUser) {

        const success =
            await initializeAuth();


        if (!success) {

            pinError.textContent =
                "Couldn't connect to the journal. Check your internet connection and try again.";

            return;
        }
    }


    // Open journal
    lockScreen.classList.add("hidden");

    journalScreen.classList.remove("hidden");

    pinError.textContent = "";


    // Load today's entry
    await loadTodayEntry();
}


// Unlock button
unlockBtn.addEventListener(
    "click",
    unlockJournal
);


// ============================================
// LOCK
// ============================================

function lockJournal() {

    journalScreen.classList.add("hidden");

    lockScreen.classList.remove("hidden");


    // Clear PIN
    pinInputs.forEach(input => {

        input.value = "";

    });


    // Clear journal form
    journalText.value = "";

    shareEntry.checked = false;

    selectedMood = "";


    moodButtons.forEach(button => {

        button.classList.remove("selected");

    });


    savedMessage.textContent = "";

    pinError.textContent = "";

    pinInputs[0].focus();
}


lockBtn.addEventListener(
    "click",
    lockJournal
);


// ============================================
// MOODS
// ============================================

moodButtons.forEach(button => {

    button.addEventListener("click", () => {

        moodButtons.forEach(item => {

            item.classList.remove(
                "selected"
            );

        });


        button.classList.add(
            "selected"
        );


        selectedMood =
            button.dataset.mood;

    });

});


// ============================================
// LOAD TODAY'S ENTRY
// ============================================

async function loadTodayEntry() {

    if (!currentUser) {
        return;
    }


    const today = getToday();


    const {
        data,
        error
    } = await supabaseClient
        .from("journal_entries")
        .select("*")
        .eq("user_id", currentUser.id)
        .eq("entry_date", today)
        .maybeSingle();


    if (error) {

        console.error(
            "Load error:",
            error
        );

        return;
    }


    if (!data) {

        journalText.value = "";

        shareEntry.checked = false;

        selectedMood = "";


        moodButtons.forEach(button => {

            button.classList.remove(
                "selected"
            );

        });

        return;
    }


    journalText.value =
        data.content || "";


    shareEntry.checked =
        data.shared || false;


    selectedMood =
        data.mood || "";


    moodButtons.forEach(button => {

        button.classList.remove(
            "selected"
        );


        if (
            button.dataset.mood ===
            selectedMood
        ) {

            button.classList.add(
                "selected"
            );

        }

    });
}


// ============================================
// SAVE ENTRY
// ============================================

saveBtn.addEventListener(
    "click",
    saveEntry
);


async function saveEntry() {

    const text =
        journalText.value.trim();


    if (!text) {

        showMessage(
            "Write something before saving.",
            true
        );

        return;
    }


    if (!currentUser) {

        showMessage(
            "Connecting...",
            true
        );

        const success =
            await initializeAuth();


        if (!success) {

            showMessage(
                "Couldn't connect to the server.",
                true
            );

            return;
        }
    }


    saveBtn.disabled = true;

    saveBtn.textContent =
        "Saving...";


    const today = getToday();


    // Check whether today's entry exists
    const {
        data: existingEntry,
        error: findError
    } = await supabaseClient
        .from("journal_entries")
        .select("id")
        .eq(
            "user_id",
            currentUser.id
        )
        .eq(
            "entry_date",
            today
        )
        .maybeSingle();


    if (findError) {

        console.error(
            "Find entry error:",
            findError
        );

        showMessage(
            "Couldn't save entry.",
            true
        );

        resetSaveButton();

        return;
    }


    let result;


    // UPDATE
    if (existingEntry) {

        result =
            await supabaseClient
                .from("journal_entries")
                .update({

                    mood:
                        selectedMood || null,

                    content:
                        text,

                    shared:
                        shareEntry.checked,

                    updated_at:
                        new Date().toISOString()

                })
                .eq(
                    "id",
                    existingEntry.id
                );
    }


    // INSERT
    else {

        result =
            await supabaseClient
                .from("journal_entries")
                .insert({

                    user_id:
                        currentUser.id,

                    entry_date:
                        today,

                    mood:
                        selectedMood || null,

                    content:
                        text,

                    shared:
                        shareEntry.checked

                });
    }


    if (result.error) {

        console.error(
            "Save error:",
            result.error
        );

        showMessage(
            "Couldn't save entry.",
            true
        );

    } else {

        showMessage(
            "Saved securely.",
            false
        );
    }


    resetSaveButton();
}


// ============================================
// MESSAGE
// ============================================

function showMessage(
    message,
    isError = false
) {

    savedMessage.textContent =
        message;

    savedMessage.style.color =
        isError
            ? "#d94c4c"
            : "#4f8a65";


    setTimeout(() => {

        savedMessage.textContent = "";

    }, 3000);
}


// ============================================
// RESET SAVE BUTTON
// ============================================

function resetSaveButton() {

    saveBtn.disabled = false;

    saveBtn.textContent =
        "Save today's entry";
}


