// ===============================
// DAILY — V1
// ===============================

// Change this PIN before giving the site to her.
const CORRECT_PIN = "1234";


// ===============================
// ELEMENTS
// ===============================

const lockScreen = document.getElementById("lockScreen");
const journalScreen = document.getElementById("journalScreen");

const unlockBtn = document.getElementById("unlockBtn");
const lockBtn = document.getElementById("lockBtn");

const pinInputs = document.querySelectorAll(".pin");
const pinError = document.getElementById("pinError");

const todayDate = document.getElementById("todayDate");
const journalText = document.getElementById("journalText");

const shareEntry = document.getElementById("shareEntry");
const saveBtn = document.getElementById("saveBtn");
const savedMessage = document.getElementById("savedMessage");

const moodButtons = document.querySelectorAll(".mood");


// ===============================
// DATE
// ===============================

function updateDate() {

    const today = new Date();

    const options = {
        weekday: "long",
        month: "long",
        day: "numeric"
    };

    todayDate.textContent =
        today.toLocaleDateString("en-US", options);
}

updateDate();


// ===============================
// PIN INPUT
// ===============================

pinInputs.forEach((input, index) => {

    input.addEventListener("input", () => {

        input.value = input.value.replace(/\D/g, "");

        if (input.value && index < pinInputs.length - 1) {
            pinInputs[index + 1].focus();
        }

    });


    input.addEventListener("keydown", (event) => {

        if (
            event.key === "Backspace" &&
            !input.value &&
            index > 0
        ) {
            pinInputs[index - 1].focus();
        }

    });

});


// ===============================
// UNLOCK
// ===============================

function unlockJournal() {

    let enteredPin = "";

    pinInputs.forEach(input => {
        enteredPin += input.value;
    });


    if (enteredPin === CORRECT_PIN) {

        lockScreen.classList.add("hidden");
        journalScreen.classList.remove("hidden");

        pinError.textContent = "";

        loadTodayEntry();

    } else {

        pinError.textContent = "Incorrect PIN.";

        pinInputs.forEach(input => {
            input.value = "";
        });

        pinInputs[0].focus();
    }
}

unlockBtn.addEventListener("click", unlockJournal);


// Press Enter to unlock
pinInputs.forEach(input => {

    input.addEventListener("keydown", event => {

        if (event.key === "Enter") {
            unlockJournal();
        }

    });

});


// ===============================
// LOCK
// ===============================

function lockJournal() {

    journalScreen.classList.add("hidden");
    lockScreen.classList.remove("hidden");

    pinInputs.forEach(input => {
        input.value = "";
    });

    pinInputs[0].focus();

}

lockBtn.addEventListener("click", lockJournal);


// ===============================
// MOOD
// ===============================

let selectedMood = "";

moodButtons.forEach(button => {

    button.addEventListener("click", () => {

        moodButtons.forEach(item => {
            item.classList.remove("selected");
        });

        button.classList.add("selected");

        selectedMood = button.dataset.mood;

    });

});


// ===============================
// SAVE ENTRY
// ===============================

saveBtn.addEventListener("click", () => {

    const text = journalText.value.trim();

    if (!text) {

        savedMessage.style.color = "#d94c4c";
        savedMessage.textContent =
            "Write something before saving.";

        return;
    }


    const today = new Date()
        .toISOString()
        .split("T")[0];


    const entry = {

        date: today,

        mood: selectedMood,

        text: text,

        shared: shareEntry.checked,

        savedAt: new Date().toISOString()

    };


    localStorage.setItem(
        `daily-entry-${today}`,
        JSON.stringify(entry)
    );


    savedMessage.style.color = "#4f8a65";
    savedMessage.textContent =
        "Saved for today.";


    setTimeout(() => {
        savedMessage.textContent = "";
    }, 3000);

});


// ===============================
// LOAD TODAY'S ENTRY
// ===============================

function loadTodayEntry() {

    const today = new Date()
        .toISOString()
        .split("T")[0];


    const savedEntry =
        localStorage.getItem(`daily-entry-${today}`);


    if (!savedEntry) {
        return;
    }


    const entry = JSON.parse(savedEntry);


    journalText.value = entry.text || "";

    selectedMood = entry.mood || "";

    shareEntry.checked = entry.shared || false;


    moodButtons.forEach(button => {

        button.classList.remove("selected");

        if (button.dataset.mood === selectedMood) {
            button.classList.add("selected");
        }

    });

}


// ===============================
// START
// ===============================

pinInputs[0].focus();
